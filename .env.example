# Firebase web app config (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Production uses the app domain with the /__/auth reverse proxy (see README).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=quizpop-sandy.vercel.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only service account. Never add NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM private key; escaped newlines are supported.
FIREBASE_PRIVATE_KEY=
# Comma-separated verified Google email addresses, managed by the owner only.
ADMIN_EMAILS=acttion543@gmail.com
# Optional local Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
